def go_to(page):
    st.session_state.page = page
    st.rerun()

def logout():
    st.session_state.user = None
    st.session_state.page = "Home"
    st.rerun()
def submit_resource_request(resource_id, owner_id, requester_id, message):
    conn = sqlite3.connect(smart_village.db)
    c = conn.cursor()

    try:
        c.execute("""
            INSERT INTO requests
            (resource_id, requester_id, owner_id, message, status)
            VALUES (?, ?, ?, ?, 'Pending')
        """, (resource_id, requester_id, owner_id, message))

        conn.commit()
        return True

    except sqlite3.Error as e:
        st.error(f"Could not submit request: {e}")
        return False

    finally:
        conn.close()
