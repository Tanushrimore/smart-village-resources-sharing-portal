DB_FILE = "smart_village.db"

def init_db():
   
   def init_db():
    """Create database tables if they do not exist."""
    conn = sqlite3.connect("smart_village.db")
    c = conn.cursor()
    # Users Table
    c.execute('''
        CREATE TABLE IF NOT EXISTS requests (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            email TEXT UNIQUE NOT NULL,
            phone TEXT NOT NULL,
            village TEXT NOT NULL,
            password TEXT NOT NULL,
            role TEXT NOT NULL
        )
    ''')
    
    # Resources Table
    
    # Resource Requests Table
    c.execute("""
        CREATE TABLE IF NOT EXISTS requests (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            resource_id INTEGER NOT NULL,
            requester_id INTEGER NOT NULL,
            owner_id INTEGER NOT NULL,
            message TEXT,
            status TEXT DEFAULT 'Pending',
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    
    conn.commit()
    conn.close()

def hash_password(password):
    """Hash password using SHA-256 for security."""
    return hashlib.sha256(password.encode()).hexdigest()

def register_user(name, email, phone, village, password, role):
    """Insert a new user into the database."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    try:
        c.execute('''
            INSERT INTO users (name, email, phone, village, password, role)
            VALUES (?, ?, ?, ?, ?, ?)
        ''', (name, email.lower().strip(), phone, village, hash_password(password), role))
        conn.commit()
        conn.close()
        return True, "Account created successfully! 🎉"
    except sqlite3.IntegrityError:
        conn.close()
        return False, "An account with this email already exists."

def authenticate_user(email, password):
    """Check credentials against the database."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute('''
        SELECT id, name, email, phone, role, village FROM users 
        WHERE email = ? AND password = ?
    ''', (email.lower().strip(), hash_password(password)))
    user = c.fetchone()
    conn.close()
    return user

def add_resource(owner_id, owner_name, owner_phone, title, category, village, description):
    """Add a new resource listing to the database."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute('''
        INSERT INTO resources (owner_id, owner_name, owner_phone, title, category, village, description)
        VALUES (?, ?, ?, ?, ?, ?, ?)
    ''', (owner_id, owner_name, owner_phone, title, category, village, description))
    conn.commit()
    conn.close()

def get_resources(category_filter="All", village_filter="All"):
    """Fetch resource listings with optional filtering."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()

    query = """
        SELECT id, title, category, village, description,
               owner_name, owner_phone, status, owner_id
        FROM resources
        WHERE 1=1
    """
    params = []

    if category_filter != "All":
        query += " AND category = ?"
        params.append(category_filter)

    if village_filter != "All":
        query += " AND village = ?"
        params.append(village_filter)

    query += " ORDER BY id DESC"
    c.execute(query, params)
    rows = c.fetchall()
    conn.close()
    return rows


